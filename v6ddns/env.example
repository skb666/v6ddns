# 阿里云凭据示例。安装脚本会用你的 --token 覆盖这个文件。
# 实际路径: /etc/v6-ddns/env  (root:root 0600)
#
# 怎么建 RAM 用户、怎么授权: 见 README.md「阿里云配置」章节
# 需要的 Action（自定义策略 v6ddns-minimal）:
#   alidns:DescribeSubDomainRecords   查询现有记录（每次运行都要用，必需）
#   alidns:AddDomainRecord            首次创建记录（必需）
#   alidns:UpdateDomainRecord         地址变化时更新（必需）
#   alidns:DeleteDomainRecord         续期后清理 TXT（缺失会堆积垃圾记录）
#
# 域名的 NS 必须是 ns1/ns2.alibabadns.com，否则这套跑不了:
#   dig +short NS example.com
V6DDNS_PROVIDER=alidns
V6DDNS_DOMAIN=example.com
V6DDNS_HOST=@
V6DDNS_TOKEN=AKIDxxxx,AKSECRETxxxx
